# This app. Local dev runs on 3006 (hub 3001, IdP 3002, pay 3003, potta-backend 3004).
NEXT_PUBLIC_APP_URL=https://potta.instanvi.com

# potta-backend (POS + Books API). Local: http://localhost:3004/api/
NEXT_PUBLIC_API_BASE_URL=https://potta.dev.instanvi.com/api/

# instanvi-auth-starter (IdP API) and the hub (instanvi-auth-frontend). Local: http://localhost:3002/api and http://localhost:3001
NEXT_PUBLIC_AUTH_API_URL=https://auth.instanvi.com/api
NEXT_PUBLIC_SUPER_APP_URL=https://auth.instanvi.com
# Must match the hub's NEXT_PUBLIC_AUTH_PAYLOAD_SECRET (AES key of the /auth-callback payload)
NEXT_PUBLIC_AUTH_PAYLOAD_SECRET=change-me

# next-auth (AUTH_URL / NEXTAUTH_URL = this app's origin; local http://localhost:3006)
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3006
NEXTAUTH_URL=http://localhost:3006

# Show dummy user data without the IdP (local UI work only)
NEXT_PUBLIC_DEV_MODE=false
