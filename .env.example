# Local port map (Instanvi):
#   hub (auth frontend)  3001
#   IdP (auth-starter)   3002
#   pay frontend         3003
#   potta-backend        3004
#   payment-service      3005
#   potta-web (this app) 3006
#   talk-BE              5004

# This app. Local: http://localhost:3006
NEXT_PUBLIC_APP_URL=https://potta.instanvi.com

# potta-backend (POS + Books API). Must end with /api/ (client normalizes if missing).
# Local: http://localhost:3004/api/
NEXT_PUBLIC_API_BASE_URL=https://potta.dev.instanvi.com/api/

# instanvi-auth-starter (IdP). Used for session, permissions, hierarchy, and
# GET /organizations/:id (logo + business address/tax for invoice branding).
# Local: http://localhost:3002/api
NEXT_PUBLIC_AUTH_API_URL=https://auth.instanvi.com/api

# Hub (instanvi-auth-frontend) — login handoff target.
# Local: http://localhost:3001
NEXT_PUBLIC_SUPER_APP_URL=https://auth.instanvi.com

# Must match the hub's NEXT_PUBLIC_AUTH_PAYLOAD_SECRET (AES key of the /auth-callback payload)
NEXT_PUBLIC_AUTH_PAYLOAD_SECRET=change-me

# Payroll / expense API (Accounts Payable → Expenses, employees, expense projects).
# Browser calls go through /payroll-proxy (next.config rewrite) so CORS is not required.
# If unset, defaults to https://api.spend.instanvi.com/api/
# Local payroll-expense-be example: http://localhost:3007/api/
NEXT_PUBLIC_PAYROLL_API_URL=https://api.spend.instanvi.com/api/
# Optional server-only override for the rewrite target (defaults to NEXT_PUBLIC_PAYROLL_API_URL):
# PAYROLL_API_PROXY_TARGET=https://api.spend.instanvi.com/api/

# next-auth (AUTH_URL / NEXTAUTH_URL = this app's origin; local http://localhost:3006)
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3006
NEXTAUTH_URL=http://localhost:3006

# Show dummy user data without the IdP (local UI work only)
NEXT_PUBLIC_DEV_MODE=false
